{
  "family": "s3-lab-task",
  "cpu": "512",
  "memory": "1024",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::711387109786:role/s3-lab-task-execution-role",
  "taskRoleArn": "arn:aws:iam::711387109786:role/s3-lab-task-role",
  "containerDefinitions": [{
    "name": "s3-lab-container",
    "image": "<IMAGE1_NAME>",
    "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
    "essential": true,
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/s3-lab",
        "awslogs-region": "eu-central-1",
        "awslogs-stream-prefix": "ecs"
      }
    },
    "environment": [
      {"name": "SERVER_PORT",            "value": "8080"},
      {"name": "SPRING_PROFILES_ACTIVE", "value": "prod"},
      {"name": "S3_BUCKET",              "value": "s3-lab-images-711387109786"},
      {"name": "CLOUDFRONT_URL",             "value": "https://d3g8082h53pxc7.cloudfront.net"},
      {"name": "CLOUDFRONT_DISTRIBUTION_ID", "value": "E21ARISJ4IFYYF"},
      {"name": "DB_HOST",                "value": "s3-lab-db.cbe28a8u4arp.eu-central-1.rds.amazonaws.com"},
      {"name": "DB_PORT",                "value": "5432"},
      {"name": "DB_NAME",                "value": "photodb"},
      {"name": "DB_USERNAME",            "value": "photoapp"}
    ],
    "secrets": [
      {
        "name": "DB_PASSWORD",
        "valueFrom": "arn:aws:secretsmanager:eu-central-1:711387109786:secret:s3-lab/db-password-icAZdx"
      }
    ],
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 60
    }
  }]
}
